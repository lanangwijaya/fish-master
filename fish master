-- FETCH
-- ═══════════════════════════════════════════════════════════════════════
local function stripBOM(s)
    if type(s) ~= "string" then return s end
    if s:sub(1, 3) == "\239\187\191" then return s:sub(4) end
    return s
end

local function isHTMLError(body)
    if type(body) ~= "string" or #body < 16 then return false end
    local head = body:sub(1, 200):lower()
    return head:find("<!doctype html", 1, true) ~= nil
        or head:find("<html", 1, true) ~= nil
        or head:find("404: not found", 1, true) ~= nil
end

local function httpFetch(url)
    local ok, body = pcall(function() return game:HttpGet(url, true) end)
    if ok and type(body) == "string" and #body > 0 then return body end
    local req = (syn and syn.request) or request or http_request
    if req then
        local ok2, res = pcall(req, {
            Url = url,
            Method = "GET",
            Headers = { ["User-Agent"] = USER_AGENT },
        })
        if ok2 and res and res.Body then return res.Body end
    end
    return nil
end

local function fetchScript(fileName)
    local urls = {
        BASE .. fileName .. "?t=" .. tostring(os.time()),
        MIRROR .. fileName,
        BASE .. fileName,
    }
    local lastErr = "no url tried"
    for _, url in ipairs(urls) do
        local body = httpFetch(url)
        if body then
            body = stripBOM(body)
            if not isHTMLError(body) and #body > 32 then
                return body, url
            else
                lastErr = "HTML/invalid body from " .. url
            end
        else
            lastErr = "fetch returned nil: " .. url
        end
    end
    return nil, lastErr
end

