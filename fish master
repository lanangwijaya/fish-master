-- FISHING BOOST
-- ═══════════════════════════════════════════════════════════════════════
local isFishingPre = FISHING[game.CreatorId] or FISHING[game.PlaceId]

local FishingBoost
if isFishingPre then
    FishingBoost = {}
    FishingBoost.CFG = {
        biasRoll      = true,
        speedWaits    = true,
        spamCast      = true,
        castRate      = 0.03,
        teleport      = true,
        logRemotes    = true,
        biasFloor     = 0.90,
        autoMinigame  = true,
    }
    FishingBoost.castCount = 0
    FishingBoost.spamAlive = false

    function FishingBoost.buildEnv()
        local env = setmetatable({}, {__index = _G})
        local FLOOR = FishingBoost.CFG.biasFloor

        local mathEnv = setmetatable({}, {__index = math})
        local realRandom = math.random
        mathEnv.random = function(a, b)
            if a == nil then
                return FLOOR + realRandom() * (1 - FLOOR - 0.0001)
            elseif b == nil then
                if a <= 1 then return 1 end
                local low = math.floor(a * FLOOR) + 1
                return low + math.floor(realRandom() * (a - low + 1))
            else
                local span = b - a + 1
                local low = a + math.floor(span * FLOOR)
                return low + math.floor(realRandom() * (b - low + 1))
            end
        end
        env.math = mathEnv

        local taskEnv = setmetatable({}, {__index = task})
        taskEnv.wait = function(t) return task.wait((t or 0) * 0.15) end
        taskEnv.delay = function(t, f) return task.delay((t or 0) * 0.15, f) end
        env.task = taskEnv
        env.wait = function(t) return task.wait((t or 0) * 0.15) end

        return env
    end

    function FishingBoost.findRemotes()
        local patterns = {
            "cast", "catch", "reel", "fish", "drop", "throw",
            "bob", "hook", "lure", "bite", "splash", "line"
        }
        local found = {}
        local function scan(parent)
            for _, obj in ipairs(parent:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    local lower = obj.Name:lower()
                    for _, p in ipairs(patterns) do
                        if lower:find(p, 1, true) then
                            table.insert(found, obj)
                            break
                        end
                    end
                end
            end
        end
        scan(game:GetService("ReplicatedStorage"))
        scan(workspace)
        return found
    end

    function FishingBoost.startSpam(remotes)
        FishingBoost.spamAlive = true
        for _, remote in ipairs(remotes) do
            task.spawn(function()
                while FishingBoost.spamAlive do
                    pcall(function()
                        if remote:IsA("RemoteEvent") then
                            remote:FireServer()
                        elseif remote:IsA("RemoteFunction") then
                            remote:InvokeServer()
                        end
                        FishingBoost.castCount = FishingBoost.castCount + 1
                    end)
                    task.wait(FishingBoost.CFG.castRate)
                end
            end)
        end
    end

    -- ── auto-complete minigame (mouse + touch + space spam) ───────────
    function FishingBoost.startAutoMinigame()
        local VirtualUser = game:GetService("VirtualUser")

        -- mouse1 spam
        task.spawn(function()
            while FishingBoost.spamAlive do
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(0.5, 0.5))
                end)
                task.wait(0.016)
            end
        end)

        -- touch tap
        task.spawn(function()
            while FishingBoost.spamAlive do
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new(0.5, 0.5))
                end)
                task.wait(0.05)
            end
        end)

        -- space via VirtualInputManager
        pcall(function()
            local VIM = game:GetService("VirtualInputManager")
            task.spawn(function()
                while FishingBoost.spamAlive do
                    pcall(function()
                        VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                        task.wait(0.02)
                        VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                    end)
                    task.wait(0.02)
                end
            end)
        end)
    end

    -- ── GUI watcher — burst saat minigame muncul ──────────────────────
    function FishingBoost.watchMinigame()
        local patterns = {
            "minigame", "mini_game", "reel", "catch", "timing",
            "bar", "progress", "fishbar", "tension", "struggle",
            "fight", "green", "zone", "meter"
        }

        local function looksLikeMinigame(obj)
            if not obj:IsA("GuiObject") then return false end
            local n = obj.Name:lower()
            for _, p in ipairs(patterns) do
                if n:find(p, 1, true) then return true end
            end
            return false
        end

        local lastDetect = 0

        local function onDescendantAdded(desc)
            if not looksLikeMinigame(desc) then return end
            if os.clock() - lastDetect < 0.2 then return end
            lastDetect = os.clock()
            FishingBoost.castCount = FishingBoost.castCount + 1

            task.spawn(function()
                local vu = game:GetService("VirtualUser")
                for i = 1, 20 do
                    pcall(function()
                        vu:CaptureController()
                        vu:ClickButton1(Vector2.new(0.5, 0.5))
                    end)
                    task.wait(0.015)
                end
            end)
        end

        task.spawn(function()
            local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
            PlayerGui.DescendantAdded:Connect(onDescendantAdded)
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                CoreGui.DescendantAdded:Connect(onDescendantAdded)
            end)
        end)
    end

    function FishingBoost.findWater()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Material == Enum.Material.Water then
                return obj
            end
        end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("water", 1, true) or n:find("pond", 1, true)
                or n:find("lake", 1, true)  or n:find("ocean", 1, true)
                or n:find("river", 1, true) or n:find("pool", 1, true) then
                    return obj
                end
            end
        end
        return nil
    end

    function FishingBoost.teleportToWater()
        local water = FishingBoost.findWater()
        if not water then return false end
        local char = LocalPlayer.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        local top = water.Position.Y + water.Size.Y * 0.5
        hrp.CFrame = CFrame.new(water.Position.X, top + 3, water.Position.Z)
        return true
    end

    function FishingBoost.installHUD()
        local HUD = Instance.new("Frame", Toast)
        HUD.Name = "FishHUD"
        HUD.Size = UDim2.new(0, 260, 0, 28)
        HUD.Position = UDim2.new(1, -276, 0, 70)
        HUD.BackgroundColor3 = Color3.fromRGB(12, 20, 12)
        HUD.BorderSizePixel = 0
        Instance.new("UICorner", HUD).CornerRadius = UDim.new(0, 8)
        local HS = Instance.new("UIStroke", HUD)
        HS.Color = Color3.fromRGB(120, 220, 120)
        HS.Thickness = 1

        local HLbl = Instance.new("TextLabel", HUD)
        HLbl.Size = UDim2.new(1, -16, 1, 0)
        HLbl.Position = UDim2.new(0, 8, 0, 0)
        HLbl.BackgroundTransparency = 1
        HLbl.Text = "[fish] starting..."
        HLbl.TextColor3 = Color3.fromRGB(190, 235, 190)
        HLbl.Font = Enum.Font.Code
        HLbl.TextSize = 10
        HLbl.TextXAlignment = Enum.TextXAlignment.Left

        task.spawn(function()
            while HUD.Parent and FishingBoost.spamAlive do
                local rate = FishingBoost.CFG.castRate > 0 and (1 / FishingBoost.CFG.castRate) or 0
                HLbl.Text = string.format(
                    "[fish] casts:%d  rate:%.0f/s  rng:%.0f%%",
                    FishingBoost.castCount,
                    rate,
                    FishingBoost.CFG.biasFloor * 100
                )
                task.wait(0.25)
            end
        end)
    end

    function FishingBoost.start()
        setToast("Fishing boost: ON", Color3.fromRGB(120, 235, 120))
        local remotes = FishingBoost.findRemotes()
        if FishingBoost.CFG.logRemotes then
            local names = {}
            for _, r in ipairs(remotes) do table.insert(names, r.Name) end
            print("[Ouroboros fishing] remotes found: " .. (#names > 0 and table.concat(names, ", ") or "(none)"))
        end
        if FishingBoost.CFG.teleport then
            task.spawn(function()
                task.wait(1.5)
                FishingBoost.teleportToWater()
            end)
        end
        if FishingBoost.CFG.spamCast and #remotes > 0 then
            FishingBoost.startSpam(remotes)
        end
        if FishingBoost.CFG.autoMinigame then
            FishingBoost.startAutoMinigame()
            FishingBoost.watchMinigame()
        end
        FishingBoost.installHUD()
    end
end

-- ═══════════════════════════════════════════════════════════════════════
-- RESOLVE + EXECUTE
-- ═══════════════════════════════════════════════════════════════════════
local file = places[game.PlaceId] or games[game.CreatorId]
if not file then
    setToast("No script for this game", Color3.fromRGB(235, 190, 80))
    killToast(3)
    return
end

local isFishing = FISHING[game.CreatorId] or FISHING[game.PlaceId]
setToast("Loading: " .. file .. (isFishing and " [fishing]" or ""))

task.wait(math.random())

pcall(function()
    local body = httpFetch(BASE .. "donation.lua")
    if body then
        local fn = loadstring(body)
        if fn then pcall(fn) end
    end
end)

local maxAttempts = isFishing and 4 or 2
local lastError
local ok = false

for attempt = 1, maxAttempts do
    setToast("Attempt " .. attempt .. "/" .. maxAttempts .. ": " .. file)
    local body, srcUrl = fetchScript(file)
    if not body then
        lastError = srcUrl
    else
        local fn, compileErr = loadstring(body)
        if not fn then
            lastError = "compile: " .. tostring(compileErr)
        else
            if isFishing and FishingBoost then
                local env = FishingBoost.buildEnv()
                local wrapped = false
                if type(setfenv) == "function" then
                    wrapped = pcall(setfenv, fn, env)
                elseif debug and debug.setupvalue then
                    wrapped = pcall(debug.setupvalue, fn, 1, env)
                end
                if not wrapped and FishingBoost.CFG.logRemotes then
                    warn("[Ouroboros fishing] env wrap unavailable — rng bias + wait speedup skipped")
                end
            end

            local runOk, runErr = pcall(fn)
            if runOk then
                ok = true
                setToast("Loaded: " .. file, Color3.fromRGB(120, 235, 120))
                if isFishing and FishingBoost then
                    task.spawn(function()
                        task.wait(0.8)
                        pcall(FishingBoost.start)
                    end)
                else
                    killToast(2)
                end
                break
            else
                lastError = "runtime: " .. tostring(runErr)
            end
        end
    end
    if attempt < maxAttempts then task.wait(0.8 * attempt) end
end

if not ok then
    setToast("Failed: " .. tostring(lastError):sub(1, 48), Color3.fromRGB(220, 90, 90))
    warn("[Ouroboros] load failed for " .. file .. " — " .. tostring(lastError))
    killToast(6)
end
