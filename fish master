-- 5. DUMP FUNCTION
-- ═══════════════════════════════════════════════════════════════════════
local function dumpCapture()
    print("\n\n============================================================")
    print("FISHING CAPTURE DUMP — copy semua dan kirim ke P")
    print("============================================================")

    print("\n--- REMOTE DEFS (" .. #CAP.remoteDefs .. ") ---")
    for i, r in ipairs(CAP.remoteDefs) do
        print(string.format("  [%d] %s (%s) @ %s", i, r.name, r.className, r.path))
    end

    print("\n--- REMOTE CALLS (" .. #CAP.remoteCalls .. ") ---")
    for i, c in ipairs(CAP.remoteCalls) do
        local argStr = ""
        for j = 1, c.argCount do
            local v = c.args[j]
            local tv = type(v)
            if tv == "string" or tv == "number" or tv == "boolean" then
                argStr = argStr .. tostring(v) .. ", "
            elseif tv == "Instance" then
                argStr = argStr .. "<" .. v.ClassName .. ":" .. v.Name .. ">, "
            elseif tv == "table" then
                argStr = argStr .. "<table>, "
            elseif tv == "Vector3" then
                argStr = argStr .. "<Vector3>, "
            else
                argStr = argStr .. "<" .. tv .. ">, "
            end
        end
        print(string.format("  [%d] %s.%s(%s)", i, c.name, c.method, argStr))
    end

    print("\n--- GUI EVENTS (" .. #CAP.guiSnapshots .. ") ---")
    for i, g in ipairs(CAP.guiSnapshots) do
        print(string.format("  [%d] %s (%s) parent=%s | pos=%s | size=%s | text=%s",
            i, g.name, g.className, g.parent, g.position or "-", g.absoluteSize or "-", tostring(g.text or "-")))
    end

    print("\n--- PROMPTS / DETECTORS (" .. vlen and "" or tostring(#CAP.prompts) .. ") ---")
    local promptCount = 0
    for k, p in pairs(CAP.prompts) do
        promptCount = promptCount + 1
        print(string.format("  [%d] %s: %s | parent=%s | action=%s",
            promptCount, p.type, p.name, p.parent, tostring(p.actionText or "-")))
    end

    print("\n============================================================")
    print("END DUMP")
    print("============================================================\n")
end

