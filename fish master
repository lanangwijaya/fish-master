-- 2. DETEKSI GUI YANG MUNCUL SAAT MANCING
-- ═══════════════════════════════════════════════════════════════════════
local guiWatchOn = true

local function snapshotGui(obj)
    local snap = {
        name = obj.Name,
        className = obj.ClassName,
        parent = obj.Parent and obj.Parent.Name or "nil",
        size = obj:IsA("GuiObject") and tostring(obj.Size) or nil,
        position = obj:IsA("GuiObject") and tostring(obj.Position) or nil,
        absoluteSize = obj:IsA("GuiObject") and tostring(obj.AbsoluteSize) or nil,
        absolutePosition = obj:IsA("GuiObject") and tostring(obj.AbsolutePosition) or nil,
        text = obj:IsA("TextLabel") or obj:IsA("TextButton") and obj.Text or nil,
        image = obj:IsA("ImageLabel") or obj:IsA("ImageButton") and obj.Image or nil,
        time = os.clock(),
    }
    table.insert(CAP.guiSnapshots, snap)
    print(string.format("[CAP] GUI+ %s (%s) parent=%s pos=%s",
        snap.name, snap.className, snap.parent, snap.position or "-"))
end

task.spawn(function()
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    pg.DescendantAdded:Connect(function(obj)
        if not guiWatchOn then return end
        if obj:IsA("GuiObject") then
            -- skip tooltips kecil
            if obj:IsA("GuiObject") and obj.AbsoluteSize.Magnitude > 30 then
                snapshotGui(obj)
            end
        end
    end)
    pcall(function()
        game:GetService("CoreGui").DescendantAdded:Connect(function(obj)
            if not guiWatchOn then return end
            if obj:IsA("GuiObject") and obj.AbsoluteSize.Magnitude > 30 then
                snapshotGui(obj)
            end
        end)
    end)
end)

