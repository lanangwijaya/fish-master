-- 1. HOOK SEMUA REMOTE — log FireServer/InvokeServer
-- ═══════════════════════════════════════════════════════════════════════
local function hookRemote(obj)
    if obj:IsA("RemoteEvent") then
        local mt = getrawmetatable and getrawmetatable(obj) or nil
        if mt then
            local old = mt.__namecall
            if old then
                setreadonly(mt, false)
                mt.__namecall = function(self, ...)
                    local method = getnamecallmethod and getnamecallmethod() or ""
                    if tostring(self) == tostring(obj) and method == "FireServer" then
                        local args = {...}
                        table.insert(CAP.remoteCalls, {
                            name = self.Name,
                            className = self.ClassName,
                            method = "FireServer",
                            args = args,
                            argCount = select("#", ...),
                            time = os.clock(),
                        })
                    end
                    return old(self, ...)
                end
                setreadonly(mt, true)
            end
        end
    end
end

-- scan semua remote dulu
local function scanRemotes()
    local found = {}
    local function walk(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                table.insert(CAP.remoteDefs, {
                    name = obj.Name,
                    className = obj.ClassName,
                    path = obj:GetFullName(),
                })
                table.insert(found, obj)
            end
        end
    end
    walk(game:GetService("ReplicatedStorage"))
    walk(workspace)
    walk(game:GetService("ServerScriptService") and game:GetService("ServerScriptService") or game)
    return found
end

